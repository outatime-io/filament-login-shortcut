{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":separateMajorReleases",
    ":prHourlyLimitNone",
    ":prConcurrentLimit10",
    ":label(dependencies)"
  ],
  "description": "Renovate policy for a Composer library package with compatibility-first version range management.",
  "enabledManagers": ["composer", "github-actions"],
  "schedule": [
    "before 10am on thursday"
  ],
  "rangeStrategy": "widen",
  "minimumReleaseAge": "3 days",
  "rebaseWhen": "behind-base-branch",
  "timezone": "Europe/Berlin",
  "commitBodyTable": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "semanticCommitType": "fix"
  },
  "packageRules": [
    {
      "description": "Keep production dependency updates reviewable and compatibility-friendly.",
      "matchManagers": ["composer"],
      "matchDepTypes": ["require"],
      "groupName": "composer production dependencies",
      "groupSlug": "composer-production-dependencies"
    },
    {
      "description": "Group development toolchain updates into a single PR.",
      "matchManagers": ["composer"],
      "matchDepTypes": ["require-dev"],
      "groupName": "composer development dependencies",
      "groupSlug": "composer-development-dependencies"
    },
    {
      "description": "Keep major framework upgrades isolated for deliberate review.",
      "matchManagers": ["composer"],
      "matchPackageNames": [
        "filament/filament",
        "illuminate/support",
        "orchestra/testbench",
        "pestphp/pest",
        "pestphp/pest-plugin-laravel",
        "larastan/larastan"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": null
    },
    {
      "description": "Group Pest and its Laravel plugin major upgrades together.",
      "matchManagers": ["composer"],
      "matchPackageNames": [
        "pestphp/pest",
        "pestphp/pest-plugin-laravel"
      ],
      "matchUpdateTypes": ["major"],
      "groupName": "pest major dependencies",
      "groupSlug": "pest-major-dependencies"
    },
    {
      "description": "Group pinned GitHub Actions SHA bumps into a single PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions"
    }
  ]
}
