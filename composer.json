{
  "name": "outatime-io/filament-login-shortcut",
  "description": "A secure login shortcut selector for Filament panels.",
  "homepage": "https://github.com/outatime-io/filament-login-shortcut",
  "keywords": ["laravel", "filament", "filament-plugin", "login-shortcut", "development", "testing"],
  "license": "MIT",
  "support": {
    "issues": "https://github.com/outatime-io/filament-login-shortcut/issues",
    "source": "https://github.com/outatime-io/filament-login-shortcut"
  },
  "type": "library",
  "require": {
    "php": "^8.2",
    "illuminate/support": "^12.0|^13.0",
    "filament/filament": "^4.0|^5.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "larastan/larastan": "^2.9|^3.0",
    "laravel/pint": "^1.0"
  },
  "autoload": {"psr-4": {"OutatimeIo\\FilamentLoginShortcut\\": "src/"}},
  "autoload-dev": {"psr-4": {"OutatimeIo\\FilamentLoginShortcut\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["OutatimeIo\\FilamentLoginShortcut\\FilamentLoginShortcutServiceProvider"]}},
  "scripts": {
    "test": "pest",
    "analyse": "php -d memory_limit=1G vendor/bin/phpstan analyse",
    "format": "pint --test",
    "check:composer": "composer validate --strict"
  },
  "config": {"sort-packages": true, "allow-plugins": {"pestphp/pest-plugin": true}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
